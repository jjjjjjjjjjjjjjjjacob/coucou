# Shared Clerk settings used by the Next.js apps
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key

# Shared Convex URL used by the Next.js apps
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Workspace routing
# Tenant client apps use NEXT_PUBLIC_COUCOU_BASE_URL to send admins to Coucou.
# In production this must be https://coucou.events for Clerk satellite sign-in.
NEXT_PUBLIC_COUCOU_BASE_URL=http://localhost:5680
NEXT_PUBLIC_COUCOU_CLERK_ORGANIZATION_SLUG=coucou
NEXT_PUBLIC_DOJO_CLERK_ORGANIZATION_ID=org_dojo
NEXT_PUBLIC_CLUB_CHLORINE_CLERK_ORGANIZATION_ID=org_club_chlorine

# Backend deployment used by `bunx convex dev`
CONVEX_DEPLOYMENT=dev:your-deployment-id

# Backend Clerk settings used by Convex
CLERK_FRONTEND_API_URL=https://your-clerk-frontend-api-url.com
# Local satellite development can hand-set a comma-separated issuer allowlist.
# Production deploys generate CLERK_FRONTEND_API_URLS from provisioned workspace-site metadata.
# CLERK_FRONTEND_API_URLS=https://clerk.coucou.events,https://clerk.dojopomodoro.club,https://clerk.clubchlorine.party,https://clerk.clubchlorine.club
CLERK_WEBHOOK_SECRET=whsec_your-clerk-webhook-secret
COUCOU_CLERK_ORGANIZATION_SLUG=coucou

# Backend SMS settings used by Convex
DEV_TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15551234567

# Fallback base URL used to generate redeem links when a site has no configured domain
APP_BASE_URL=http://localhost:2345
