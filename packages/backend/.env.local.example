# Deployment used by `bunx convex dev`
CONVEX_DEPLOYMENT=dev:your-deployment-id

# Clerk OIDC issuer used by Convex to verify Clerk tokens
# Example (dev): https://<your-subdomain>.clerk.accounts.dev
CLERK_FRONTEND_API_URL=https://your-clerk-frontend-api-url.com
# Example (local satellite development):
# Production deploys generate this allowlist from workspace-site metadata.
# CLERK_FRONTEND_API_URLS=https://clerk.coucou.events,https://clerk.dojopomodoro.club,https://clerk.clubchlorine.party,https://clerk.clubchlorine.club
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
CLERK_WEBHOOK_SECRET=whsec_your-clerk-webhook-secret

# Clerk organizations used for workspace-scoped host and door auth
COUCOU_CLERK_ORGANIZATION_SLUG=coucou

# Twilio Configuration for SMS notifications
DEV_TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15551234567

# Fallback base URL used to generate redeem links when a site has no configured domain
# Example (dev): http://localhost:2345
# Example (production): https://coucou.events
APP_BASE_URL=http://localhost:2345
