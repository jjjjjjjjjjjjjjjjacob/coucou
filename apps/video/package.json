{
  "name": "@coucou/video",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "build": "remotion bundle src/index.ts --out-dir=dist",
    "render": "remotion render src/index.ts danza-organica-drinks-on-us-9x16 out/danza-organica-drinks-on-us-9x16.mp4 --codec=h264",
    "render:date": "remotion render src/index.ts danza-organica-drinks-on-us-date-9x16 out/danza-organica-drinks-on-us-date-9x16.mp4 --codec=h264",
    "render:tomorrow": "remotion render src/index.ts danza-organica-drinks-on-us-tomorrow-9x16 out/danza-organica-drinks-on-us-tomorrow-9x16.mp4 --codec=h264",
    "render:tonight": "remotion render src/index.ts danza-organica-drinks-on-us-tonight-9x16 out/danza-organica-drinks-on-us-tonight-9x16.mp4 --codec=h264",
    "render:flyer": "remotion render src/index.ts danza-organica-moving-flyer-9x16 out/danza-organica-moving-flyer-9x16.mp4 --codec=h264",
    "render:still": "remotion still src/index.ts danza-organica-drinks-on-us-9x16",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "9.7.0",
    "@remotion/google-fonts": "4.0.509",
    "@remotion/media": "4.0.509",
    "@remotion/three": "4.0.509",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "remotion": "4.0.509",
    "three": "^0.181.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.509",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.181.0",
    "bun-types": "^1.3.0",
    "typescript": "^5"
  }
}
