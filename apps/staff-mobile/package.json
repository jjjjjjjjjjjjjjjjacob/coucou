{
  "name": "@coucou/staff-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "dev": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --no-watchman",
    "doctor": "expo-doctor",
    "export": "expo export --platform all"
  },
  "dependencies": {
    "@clerk/expo": "^4.0.2",
    "@coucou/backend": "workspace:*",
    "@coucou/sdk": "workspace:*",
    "@expo-google-fonts/geist": "^0.4.2",
    "@expo-google-fonts/geist-mono": "^0.4.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "convex": "^1.30.0",
    "expo": "~57.0.8",
    "expo-camera": "~57.0.3",
    "expo-build-properties": "~57.0.7",
    "expo-constants": "~57.0.7",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-keep-awake": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.7",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.26.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.26.2",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "expo-doctor": "^1.20.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "rootDir": "../..",
    "roots": [
      "<rootDir>/apps/staff-mobile"
    ],
    "setupFiles": [
      "<rootDir>/apps/staff-mobile/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/apps/staff-mobile/src/$1",
      "^react$": "<rootDir>/node_modules/react-native/node_modules/react",
      "^react/(.*)$": "<rootDir>/node_modules/react-native/node_modules/react/$1"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ]
  }
}
