# Clerk settings
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key
# Local satellite dev should match this app's dev host.
# Production should omit this so the app derives the Clerk satellite domain
# from the live request host and supports both production domains.
NEXT_PUBLIC_CLERK_DOMAIN=localhost:5677

# Convex URL
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Coucou workspace routing
# In production this must be https://coucou.events for Clerk satellite sign-in.
NEXT_PUBLIC_COUCOU_BASE_URL=http://localhost:5680
NEXT_PUBLIC_DANZA_ORGANICA_CLERK_ORGANIZATION_ID=org_danza_organica

# Off by default. Set to true only to test the unsupported satellite-local
# OTP page; production should redirect to the primary Coucou login.
DANZA_ORGANICA_ENABLE_SATELLITE_LOCAL_LOGIN=false
