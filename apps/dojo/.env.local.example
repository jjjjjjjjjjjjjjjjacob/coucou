# Satellite Clerk settings. Leave blank for local standalone Clerk mode.
# Production example:
# NEXT_PUBLIC_CLERK_DOMAIN=dojopomodoro.club
# NEXT_PUBLIC_CLERK_PRIMARY_SIGN_IN_URL=https://coucou.now/sign-in
NEXT_PUBLIC_CLERK_DOMAIN=
