# Clerk settings
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key

# Convex URL
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Workspace routing
NEXT_PUBLIC_COUCOU_CLERK_ORGANIZATION_SLUG=coucou

# Comma-separated extra origins coucou will accept as redirect_url
# targets when satellites send users here for sign-in. Production reads
# the allow-list from workspace.sites + the hard-coded site domains; this
# variable is the dev/preview escape hatch so localhost satellites can
# round-trip the cross-domain auth flow.
# Example:
# COUCOU_DEV_ALLOWED_SATELLITE_ORIGINS=http://localhost:5679,http://localhost:5678
