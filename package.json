{
  "name": "coucou",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "build:deploy": "turbo run deploy",
    "lint": "biome lint .",
    "lint:eslint": "turbo run lint:eslint --filter=@coucou/club-chlorine --filter=@coucou/danza-organica --filter=@coucou/dojo --filter=@coucou/site",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "test": "turbo run test && bun test scripts/__tests__",
    "test:partner-api-docs": "bun test scripts/__tests__/partner-api-docs.test.mjs",
    "test:dojo": "cd apps/dojo && bun test",
    "test:backend": "cd packages/backend && bun run test",
    "sync:convex-production-env": "bun scripts/sync-convex-production-env.mjs",
    "sync:github-production-secrets": "bun scripts/sync-github-production-secrets.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@next/eslint-plugin-next": "^16.0.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "turbo": "^2.6.3"
  },
  "overrides": {
    "convex": "1.30.0"
  },
  "packageManager": "bun@1.3.11"
}
