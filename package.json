{
  "name": "coucou",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "build:deploy": "turbo run deploy",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:dojo": "cd apps/dojo && bun test",
    "test:backend": "cd packages/backend && bun test",
    "sync:convex-production-env": "bun scripts/sync-convex-production-env.mjs",
    "sync:github-production-secrets": "bun scripts/sync-github-production-secrets.mjs"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.0.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "turbo": "^2.6.3"
  },
  "overrides": {
    "convex": "1.30.0"
  },
  "packageManager": "bun@1.2.18"
}
